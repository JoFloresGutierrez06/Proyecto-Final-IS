# Puerto del servidor
PORT=3000

# Secreto para firmar y verificar los JWT
# IMPORTANTE: nunca compartas este valor ni lo subas a Git
JWT_SECRET=cambia-esta-cadena-por-una-clave-larga-y-aleatoria

# Tiempo de expiración del token (ej: 1h, 30m, 7d)
JWT_EXPIRES_IN=1h

# Ruta del archivo de base de datos SQLite
# Si no existe la carpeta, se crea automáticamente
DATABASE_PATH=data/app.db

# Credenciales del usuario administrador creado con `npm run seed`
ADMIN_EMAIL=admin@donaciones.com
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Administrador

NODE_ENV=development
